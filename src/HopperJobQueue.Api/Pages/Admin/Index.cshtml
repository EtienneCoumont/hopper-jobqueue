@page "/admin"
@model HopperJobQueue.Api.Pages.Admin.IndexModel
@{
    ViewData["Title"] = "Vue d'ensemble";
}
@section Head {
    <meta http-equiv="refresh" content="30" />
}

<h1>Vue d'ensemble</h1>

<div class="stat-grid">
    @foreach (var status in JobStatus.All)
    {
        <div class="stat-card status-@status">
            <span class="stat-value">@(Model.Stats.CountsByStatus.GetValueOrDefault(status))</span>
            <span class="stat-label">@status</span>
        </div>
    }
</div>

<div class="panel-grid">
    <section class="panel">
        <h2>File</h2>
        <dl>
            <dt>Âge du plus vieux <code>pending</code></dt>
            <dd>@(Model.OldestPending ?? "—")</dd>
            <dt>Jobs reçus (24 h)</dt>
            <dd>@Model.Stats.Enqueued24h</dd>
            <dt>Terminés <code>done</code> (24 h)</dt>
            <dd>@Model.Stats.Done24h</dd>
            <dt>Terminés <code>failed</code> (24 h)</dt>
            <dd>@Model.Stats.Failed24h</dd>
        </dl>
    </section>

    <section class="panel">
        <h2>Dernière activité par worker</h2>
        @if (Model.Stats.Workers.Count == 0)
        {
            <p class="muted">Aucune activité de worker enregistrée.</p>
        }
        else
        {
            <table>
                <thead><tr><th>Worker</th><th>Vu pour la dernière fois</th></tr></thead>
                <tbody>
                @foreach (var worker in Model.Stats.Workers)
                {
                    <tr>
                        <td>@worker.Actor</td>
                        <td><time datetime="@worker.LastSeenAt.ToString("O")">@worker.LastSeenAt.ToString("yyyy-MM-dd HH:mm:ss") UTC</time></td>
                    </tr>
                }
                </tbody>
            </table>
        }
    </section>
</div>
