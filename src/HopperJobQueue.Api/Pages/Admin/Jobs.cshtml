@page "/admin/jobs"
@model HopperJobQueue.Api.Pages.Admin.JobsModel
@{
    ViewData["Title"] = "Jobs";
}

<h1>Jobs</h1>

<form method="get" class="filters">
    <label>Status
        <select name="status">
            <option value="">(all)</option>
            @foreach (var status in JobStatus.All)
            {
                if (status == Model.Status)
                {
                    <option value="@status" selected>@status</option>
                }
                else
                {
                    <option value="@status">@status</option>
                }
            }
        </select>
    </label>
    <label>Project <input type="text" name="project" value="@Model.Project" /></label>
    <label>Kind <input type="text" name="kind" value="@Model.Kind" /></label>
    <label>Search <input type="text" name="q" value="@Model.Q" /></label>
    <button type="submit">Filter</button>
    <a href="/admin/jobs">Reset</a>
</form>

<p class="muted">@Model.Result.Total job(s) — page @Model.Result.Page</p>

<table class="jobs-table">
    <thead>
    <tr>
        <th>Id</th>
        <th>Kind</th>
        <th>Project</th>
        <th>Status</th>
        <th>Att.</th>
        <th>Worker</th>
        <th>Created</th>
        <th>Actions</th>
    </tr>
    </thead>
    <tbody>
    @foreach (var job in Model.Result.Items)
    {
        <tr>
            <td><a href="/admin/jobs/@job.Id">#@job.Id</a></td>
            <td>@job.Kind</td>
            <td>@(job.Project ?? "—")</td>
            <td><span class="badge status-@job.Status">@job.Status</span></td>
            <td>@job.Attempts/@job.MaxAttempts</td>
            <td>@(job.WorkerId ?? "—")</td>
            <td><time datetime="@job.CreatedAt.ToString("O")">@job.CreatedAt.ToString("MM-dd HH:mm")</time></td>
            <td class="actions">
                @if (job.Status is JobStatus.Failed or JobStatus.Expired or JobStatus.Cancelled)
                {
                    <form method="post" asp-page-handler="Requeue" asp-route-id="@job.Id">
                        <input type="hidden" name="returnQuery" value="@Model.CurrentQuery" />
                        <button type="submit">Requeue</button>
                    </form>
                }
                @if (job.Status is JobStatus.Pending or JobStatus.Leased)
                {
                    <form method="post" asp-page-handler="Cancel" asp-route-id="@job.Id">
                        <input type="hidden" name="returnQuery" value="@Model.CurrentQuery" />
                        <button type="submit" class="danger">Cancel</button>
                    </form>
                }
            </td>
        </tr>
    }
    </tbody>
</table>

<nav class="pager">
    @if (Model.Result.Page > 1)
    {
        <a href="/admin/jobs?@Model.QueryForPage(Model.Result.Page - 1)">← Previous</a>
    }
    @if ((long)Model.Result.Page * Model.Result.PageSize < Model.Result.Total)
    {
        <a href="/admin/jobs?@Model.QueryForPage(Model.Result.Page + 1)">Next →</a>
    }
</nav>
