# Copy to .env next to the deployment compose.yaml and fill in.
# Traefik variant: the block at the bottom only feeds the compose labels — the
# service itself reads none of it.

# PostgreSQL password for the service (user `hopper`, database `hopper`).
HOPPER_DB_PASSWORD=change-me

# Verbose | Debug | Information | Warning | Error
HOPPER_LOG_LEVEL=Information

# Optional: bootstrap admin key (format hjq_admin_{32 base62}). If absent and the key
# table is empty, a key is generated and written ONCE to the logs.
# Revoke it from the dashboard once the real keys are created.
#HOPPER_BOOTSTRAP_ADMIN_KEY=

# Image tag pulled from ghcr.io/etiennecoumont/hopper-jobqueue. Default: latest.
# Pin a release (1.2.0) or an immutable build (sha-abc1234) for rollbacks.
#HOPPER_IMAGE_TAG=latest

#---------------------------
#   TRAEFIK CONFIGURATION
#---------------------------

# Public host
HOPPER_PUBLIC_HOST=hopper.exemple.ch

# IP ranges allowed on /admin (comma-separated).
# Dynamic connection: plan a wide range rather than disabling the protection.
HOPPER_ADMIN_IP_ALLOWLIST=203.0.113.0/24

# Other Traefik configuration: the Docker network it watches, and the entrypoint /
# certificate resolver names from its static configuration. Defaults shown.
#HOPPER_TRAEFIK_NETWORK=traefik-public
#HOPPER_TRAEFIK_ENTRYPOINT=websecure
#HOPPER_TRAEFIK_CERTRESOLVER=letsencrypt
