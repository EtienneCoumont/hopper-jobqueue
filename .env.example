# Copier vers .env (jamais commité) et remplir.

# Mot de passe PostgreSQL du service (utilisateur `hopper`, base `hopper`).
HOPPER_DB_PASSWORD=change-me

# Hôte public servi par Traefik.
HOPPER_PUBLIC_HOST=hopper.exemple.ch

# Plages IP autorisées sur /admin (séparées par des virgules). Connexion dynamique :
# prévoir une plage large plutôt que de désactiver la protection.
HOPPER_ADMIN_IP_ALLOWLIST=203.0.113.0/24

# Optionnel : clé admin d'amorçage (format hjq_admin_{32 base62}). Si absente et que la
# table des clés est vide, une clé est générée et écrite UNE FOIS dans les logs.
# À révoquer depuis le dashboard après création des vraies clés.
#HOPPER_BOOTSTRAP_ADMIN_KEY=

# Verbose | Debug | Information | Warning | Error
HOPPER_LOG_LEVEL=Information
